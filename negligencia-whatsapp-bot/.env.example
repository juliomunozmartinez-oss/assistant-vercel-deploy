# Claude (https://platform.claude.com → API Keys)
ANTHROPIC_API_KEY=
# Opcionales
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low

# WhatsApp Cloud API (developers.facebook.com → tu app → WhatsApp → Configuración de la API)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
# Texto que tú inventas y pegas igual en Meta al configurar el webhook
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v23.0

# Números de los abogados que reciben avisos (formato 521 + 10 dígitos, separados por coma)
ABOGADO_WHATSAPP=
# Plantilla aprobada en Meta para avisar aunque el abogado no haya escrito en 24 h (recomendado)
WHATSAPP_AVISO_TEMPLATE=
WHATSAPP_AVISO_TEMPLATE_LANG=es_MX

# Upstash Redis (Vercel → Storage → Upstash Redis; crea estas variables sola)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

DIAS_RETENCION=30
MAX_MENSAJES=80

# Contraseña de la página de pruebas /api/sandbox (déjala vacía en producción para desactivarla)
SANDBOX_CLAVE=
